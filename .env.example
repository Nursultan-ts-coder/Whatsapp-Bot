# Copy this file to .env and fill it in.

# The long id in your sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# The JSON key you downloaded for your Google service account.
GOOGLE_CREDENTIALS_FILE=./google-credentials.json

# Your time zone. SendAt times in the sheet are read in this zone.
TZ=Asia/Bishkek

# The tab with one row per person: a name column, a phone column, then one
# column per day (headers like 15/10/2026). Replies are written there.
PEOPLE_TAB=
NAME_COLUMN=name
PHONE_COLUMN=phone

# Every day at DAILY_TIME (24h, in your TZ) everyone in PEOPLE_TAB gets one
# message. Leave DAILY_TIME empty to turn it off.
DAILY_TIME=22:00

# Leave DAILY_MESSAGE empty to use the built-in message (in src/config.js):
#   *Ассаламу алейкум, {name} байке !*
#   Бугун, {date} канча бет китеп окуганыңызды жазып коесузбу ?
#
#   Чоң рахмат !
# {name} comes from the sheet, {date} is today's date. Use \n for a new line,
# and *text* for bold.
DAILY_MESSAGE=

# Reply sent after a number is saved. Empty uses the built-in text:
#   Рахмат, {name} байке! Бүгүнкү күнгө {number} бет жазылды.
# Write CONFIRM_MESSAGE=off to send no reply.
CONFIRM_MESSAGE=


# Optional: log in with an 8-letter code instead of a QR code.
# Your WhatsApp number with country code, digits only, e.g. 996555123456
PAIR_PHONE=

# Random wait between two people when the daily message goes out, in seconds.
# Sending to everyone at once looks like spam to WhatsApp; longer is safer.
MIN_DELAY_SECONDS=20
MAX_DELAY_SECONDS=60

# Where the WhatsApp login is saved. Keep this folder private.
AUTH_DIR=./auth

LOG_LEVEL=warn

# Optional: get an alert when the bot is logged out, offline for a while, or
# couldn't finish the daily message. Use either one, or both.
#
# 1) A WhatsApp message to your personal number, sent by CallMeBot (free).
#    Get your API key by following the steps on
#    https://www.callmebot.com/blog/free-api-whatsapp-messages/
#    ALERT_PHONE is your personal number with country code, digits only.
ALERT_PHONE=
ALERT_APIKEY=
#
# 2) A push notification from the ntfy app. Subscribe to a hard-to-guess topic
#    name and put it here, e.g. NOTIFY_URL=https://ntfy.sh/yntymak-bot-k38fj2
NOTIFY_URL=
