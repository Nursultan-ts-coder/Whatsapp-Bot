# Copy this file to .env and fill it in.

# The long id in your sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# The JSON key you downloaded for your Google service account.
GOOGLE_CREDENTIALS_FILE=./google-credentials.json

# Your time zone. SendAt times in the sheet are read in this zone.
TZ=Asia/Bishkek

# Tab names. The bot creates them with the right headers if they don't exist.
SCHEDULE_TAB=Schedule
INBOX_TAB=Inbox

# Optional: log in with an 8-letter code instead of a QR code.
# Your WhatsApp number with country code, digits only, e.g. 996555123456
PAIR_PHONE=

# How often to check the Schedule tab, in seconds.
CHECK_EVERY_SECONDS=60

# Random wait between two messages, in seconds. Longer is safer against bans.
MIN_DELAY_SECONDS=20
MAX_DELAY_SECONDS=60

# How to read slash dates like 03/04/2026: DMY (3 April) or MDY (March 4).
DATE_ORDER=DMY

# Set to true to also log messages from group chats.
LOG_GROUPS=false

# Where the WhatsApp login is saved. Keep this folder private.
AUTH_DIR=./auth

LOG_LEVEL=warn
